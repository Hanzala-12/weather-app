# API base URL for the backend (leave empty if same origin)
# Example: VITE_API_URL="https://your-backend.vercel.app"
VITE_API_URL=""

# OpenWeatherMap API key (required for ZIP code search)
# Get one at https://home.openweathermap.org/api_keys
VITE_OPENWEATHER_API_KEY="your_openweather_api_key_here"

# YouTube Data API v3 key (optional — shows search link if not set)
# Get one at https://console.cloud.google.com/apis/credentials
VITE_YOUTUBE_API_KEY="your_youtube_api_key_here"
